{
  "expo": {
    "name": "Bible AI Honduras",
    "slug": "bible-ai-honduras",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bibleai",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#E9E1D5"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.bibleaihonduras.app",
          "widgets": [
            {
              "name": "VersiculoDelDia",
              "displayName": "Versículo del día",
              "description": "El versículo de hoy. Tocalo para abrir el devocional.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "LecturaDeHoy",
              "displayName": "Tu lectura de hoy",
              "description": "La lectura de hoy de tu plan y tu racha. Tocalo para abrir el plan.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/eb-garamond/400Regular/EBGaramond_400Regular.ttf",
            "./node_modules/@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "VersiculoChico",
              "label": "Versículo del día",
              "description": "El versículo de hoy. Tocalo para abrir el devocional.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "VersiculoMediano",
              "label": "Versículo del día (mediano)",
              "description": "El versículo de hoy. Tocalo para abrir el devocional.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "LecturaDeHoy",
              "label": "Tu lectura de hoy",
              "description": "La lectura de hoy de tu plan y tu racha. Tocalo para abrir el plan.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 10800000
            }
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para proteger Mi espacio y Sentir cuando vos lo encendés en Ajustes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bibleaihonduras.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bibleaihonduras.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E9E1D5"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#E9E1D5"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28bbe778-9ec7-4940-92a3-c1ff62b0a419"
      }
    },
    "owner": "luiscf1226"
  }
}
