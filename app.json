{
  "expo": {
    "name": "Bible AI Honduras",
    "slug": "bible-ai-honduras",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "bibleai",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bibleaihonduras.app"
    },
    "android": {
      "package": "com.bibleaihonduras.app"
    }
  }
}
