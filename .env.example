# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore — nunca commitees claves reales.
#
# Para desarrollo 100% local (sin cuenta de Convex ni de Clerk todavía):
#   1. CONVEX_AGENT_MODE=anonymous npx convex dev --once
#      Esto crea un backend local y escribe CONVEX_DEPLOYMENT +
#      EXPO_PUBLIC_CONVEX_URL en .env.local automáticamente.
#   2. Sin EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY la app no arranca (auth.config.ts
#      valida el JWT de Clerk) — para probar solo Convex, correr
#      `npx convex run users:current` o los tests (`npm test`), no la app.

# App (pública — Expo la mete en el bundle)
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Convex (privada — nunca EXPO_PUBLIC_*, se configura con `npx convex env set`)
# CLERK_JWT_ISSUER_DOMAIN=https://tu-instancia.clerk.accounts.dev
