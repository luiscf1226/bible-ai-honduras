# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore — nunca commitees claves reales.
#
# Para desarrollo 100% local (sin cuenta de Convex ni de Clerk todavía):
#   1. CONVEX_AGENT_MODE=anonymous npx convex dev --once
#      Esto crea un backend local y escribe CONVEX_DEPLOYMENT +
#      EXPO_PUBLIC_CONVEX_URL en .env.local automáticamente.
#   2. Sin EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY la app no arranca (auth.config.ts
#      valida el JWT de Clerk) — para probar solo Convex, correr
#      `npx convex run users:current` o los tests (`npm test`), no la app.

# App (pública — Expo la mete en el bundle)
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Pagos (docs/monetizacion.md): vacío = edición gratuita, `test` = compra
# simulada (requiere PAYMENTS_TEST_MODE=1 en Convex), `revenuecat` = compra real.
EXPO_PUBLIC_PAYMENTS_MODE=
# Key pública de RevenueCat (nunca la secret API key). Solo se usa en modo
# `revenuecat`: una key olvidada en EAS no activa compras en la edición gratuita.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Donaciones: link https y plataformas donde se muestra (p. ej. `android`).
# Ver las reglas de cada tienda en docs/monetizacion.md antes de encender `ios`.
EXPO_PUBLIC_DONATION_URL=
EXPO_PUBLIC_DONATION_PLATFORMS=

# Convex (privada — nunca EXPO_PUBLIC_*, se configura con `npx convex env set`)
# CLERK_JWT_ISSUER_DOMAIN=https://tu-instancia.clerk.accounts.dev
# OPENAI_API_KEY=  # embeddings RV1909 + imagenes; solo en Convex, nunca en la app
# ANTHROPIC_API_KEY=  # respuesta RAG citada (#7); solo en Convex, nunca en la app
# Authorization Bearer que verifica convex/http.ts POST /revenuecat.
# npx convex env set REVENUECAT_WEBHOOK_SECRET
# REVENUECAT_WEBHOOK_SECRET=
# Modo de prueba de pagos: deja que `entitlements.grantTestPro` regale Pro por
# 30 días. Solo en un Convex de prueba, nunca en producción.
# npx convex env set PAYMENTS_TEST_MODE 1
# PAYMENTS_TEST_MODE=
# Secret key de la Backend API de Clerk. Solo la usa users.deleteAccount (#107)
# para DELETE /v1/users/{id}. Sin esta key los datos igual se borran, pero el
# usuario de identidad sobrevive y la app avisa ("clerk_pendiente") — hay que
# configurarla antes de enviar a App Store (guideline 5.1.1(v)).
# npx convex env set CLERK_SECRET_KEY
# CLERK_SECRET_KEY=
